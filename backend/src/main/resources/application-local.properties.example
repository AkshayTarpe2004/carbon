# ===============================
# PostgreSQL Database Configuration
# ===============================

spring.datasource.url=jdbc:postgresql://localhost:5432/carbontracker
spring.datasource.username=postgres
spring.datasource.password=your_postgres_password

spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# OAuth - copy this file to application-local.properties then replace the values below.
#
# 1. Run: setup-oauth.bat (or copy this file to application-local.properties)
# 2. Google: https://console.cloud.google.com/apis/credentials → Create OAuth 2.0 Client ID (Web)
#    Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
# 3. Replace 'optional' below with your real Client ID and Client secret, save, then restart the backend.

spring.security.oauth2.client.registration.google.client-id=optional
spring.security.oauth2.client.registration.google.client-secret=optional

# GitHub: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL must be: http://localhost:8080/login/oauth2/code/github
#   (not the frontend URL – the backend receives the code, then redirects to frontend with token)
# Uncomment and set:
# spring.security.oauth2.client.registration.github.client-id=your-github-client-id
# spring.security.oauth2.client.registration.github.client-secret=your-github-client-secret

# Mail — required for registration verification OTP and forgot-password OTP (email only; no log fallback).
# Gmail: use an App Password https://myaccount.google.com/apppasswords
# Ensure spring.mail.* matches your provider (host/port/properties in application.properties if needed).
# app.mail.enabled=true
# app.mail.from=your-email@gmail.com
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=your-email@gmail.com
# spring.mail.password=your-16-char-app-password-no-spaces
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# spring.mail.properties.mail.smtp.starttls.required=true

# Optional: pending checkout auto-fail (defaults are in application.properties — 24h TTL, hourly cron)
# app.pending-payment.ttl-hours=24
# app.pending-payment.expiry-cron=0 0 * * * *
