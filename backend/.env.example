# =============================================================================
# Backend environment (deployment + local)
# =============================================================================
# Option A — file: copy this file to backend/.env (gitignored)
# Option B — host: set the SAME variable names in Railway / Render / Docker / K8s
# The app loads .env from the working directory, then backend/.env
# =============================================================================

# --- PostgreSQL (required) ---
DATASOURCE_URL=jdbc:postgresql://localhost:5432/carbon_tracker
DATASOURCE_USER=postgres
DATABASE_PASSWORD=your_db_password

# --- HTTP / CORS (required for browser clients) ---
# Comma-separated origins, e.g. https://app.example.com,https://www.example.com
# Comma-separated; must include your Netlify URL in production (no trailing slash)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://personal-carbon-footprinting.netlify.app
SERVER_PORT=8080

# --- Google OAuth (required if you use Google login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (required if you use GitHub login) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the callback URL registered in GitHub OAuth app (use your public API URL in production)
GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# Where the SPA returns after OAuth (your deployed frontend origin + path)
APP_OAUTH2_AUTHORIZED_REDIRECT_URI=http://localhost:3000/oauth2/redirect

# --- Mail (required if APP_MAIL_ENABLED=true) ---
APP_MAIL_ENABLED=true
APP_MAIL_FROM=noreply@example.com
APP_MAIL_FROM_NAME=CarbonCalc
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Optional ---
# APP_PENDING_PAYMENT_TTL_HOURS=24
# APP_PENDING_PAYMENT_EXPIRY_CRON=0 0 * * * *
